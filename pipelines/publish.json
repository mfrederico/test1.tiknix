{
    "slug": "publish",
    "name": "Publish",
    "steps": [
        {
            "name": "publish_github_pr",
            "type": "publish",
            "config": {
                "target": "github-pr",
                "op": "deploy"
            },
            "on_success": "next",
            "on_fail": "exit"
        },
        {
            "name": "publish_rsync",
            "type": "publish",
            "config": {
                "target": "rsync",
                "op": "deploy",
                "config": {
                    "host": "127.0.0.1",
                    "user": "ubuntu",
                    "path": "/var/www/html/default/test-destination-rsync.tiknix"
                }
            },
            "on_success": "next",
            "on_fail": "exit"
        },
        {
            "name": "publish_tiknix_hosted",
            "type": "publish",
            "config": {
                "target": "tiknix-hosted",
                "op": "deploy",
                "config": {
                    "domain": "tiknix.ngn.sh"
                },
                "timeout": 600
            },
            "on_success": "next",
            "on_fail": "exit"
        }
    ],
    "publish": {
        "targets": [
            "github-pr",
            "rsync",
            "tiknix-hosted"
        ],
        "domain": "tiknix.ngn.sh",
        "url": "https://tiknix.ngn.sh"
    }
}
